# Copie para .env e preencha. O .env real nunca vai para o git.

# Banco de dados (conexão padrão). Com DB_DEFAULT_HOST vazio o framework
# não conecta: as páginas abrem, mas os endpoints de dados respondem erro.
DB_DEFAULT_HOST=
DB_DEFAULT_USER=
DB_DEFAULT_PASS=
DB_DEFAULT_NAME=
DB_DEFAULT_CHARSET=utf8mb4

# Segunda conexão (opcional). Só a página inicial a usa, para listar as tabelas;
# nenhum dashboard depende dela. Pode apontar para o mesmo banco da conexão padrão.
DB_2_HOST=
DB_2_USER=
DB_2_PASS=
DB_2_NAME=
DB_2_CHARSET=utf8mb4

# Aplicação
# DEV mostra stack trace; PROD mostra 500.php genérico
APP_ENV=DEV
DISPLAY_ERRORS=true
TIMEZONE=America/Sao_Paulo
# Pepper do bcrypt; não alterar depois de existirem hashes
HASH_KEY=
UPLOAD_URL=/uploads/
FORCE_HTTPS=false
FORCE_WWW=false
# Controller de fallback para URLs sem controller (opcional)
URL_CONTROL=

# Basic Auth global da aplicação (desligado por padrão)
API_MODE=false
API_USER=
API_PASSWORD=

# Token do endpoint de debug /sql/query (somente leitura)
SQL_API_TOKEN=

# Basic Auth das páginas de dashboard
DASH_AUTH_USER=
DASH_AUTH_PASSWORD=
# Origens (scheme://host, separadas por vírgula) que podem embutir os dashboards em iframe com ?to=1
DASH_IFRAME_ALLOWLIST=

# Alerta diário de pendências do módulo Hotel (cron + token)
ALERTA_EVENTOS_TOKEN=
ALERTA_EVENTOS_DESTINATARIO=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NOME=
