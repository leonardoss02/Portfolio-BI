# .env de demonstração usado pelo Docker (montado no lugar do .env do projeto).
# Credenciais fictícias: o banco só existe dentro do docker compose.

DB_DEFAULT_HOST=db
DB_DEFAULT_USER=acme
DB_DEFAULT_PASS=acme
DB_DEFAULT_NAME=acme_bi
DB_DEFAULT_CHARSET=utf8mb4

# A página inicial lista as tabelas das duas conexões; aqui as duas apontam
# para o mesmo banco.
DB_2_HOST=db
DB_2_USER=acme
DB_2_PASS=acme
DB_2_NAME=acme_bi
DB_2_CHARSET=utf8mb4

# PROD esconde detalhes de erro do visitante. O teste de fumaça usa app.dev.env.
APP_ENV=PROD
DISPLAY_ERRORS=false
TIMEZONE=America/Sao_Paulo
HASH_KEY=portfolio-demo
UPLOAD_URL=/uploads/
FORCE_HTTPS=false
FORCE_WWW=false
URL_CONTROL=

API_MODE=false
API_USER=
API_PASSWORD=

SQL_API_TOKEN=

# Login das páginas
DASH_AUTH_USER=demo
DASH_AUTH_PASSWORD=demo
DASH_IFRAME_ALLOWLIST=

ALERTA_EVENTOS_TOKEN=
ALERTA_EVENTOS_DESTINATARIO=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NOME=
